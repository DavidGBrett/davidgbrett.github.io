---
import ProjectCardsGrid from './ProjectCardsGrid.astro';
import { flowLauncherPlugins } from '../data/flowLauncherPlugins';
---

<section class="projects" aria-labelledby="projects-heading">
	<h2 id="projects-heading">Projects</h2>
	<h3>Flow Launcher Plugins</h3>

	<ProjectCardsGrid projects={flowLauncherPlugins} />
</section>

<style>
	h2 {
		margin: 0 0 1.25rem;
		font-size: clamp(1.4rem, 2vw, 1.9rem);
		color: var(--color-text);
	}

	h3 {
		margin: 0 0 1rem;
		font-size: 1.15rem;
		color: var(--color-muted);
	}

</style>
