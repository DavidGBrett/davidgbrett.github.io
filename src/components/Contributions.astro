---
import ProjectCardsGrid from './ProjectCardsGrid.astro';
import { featuredContributions } from '../data/featuredContributions';

const closedPRsLink =
  "https://github.com/search?q=is%3Apr+author%3ADavidGBrett+-user%3ADavidGBrett+is%3Aclosed&type=pullrequests";

const openPRsLink =
  "https://github.com/search?q=is%3Apr+author%3ADavidGBrett+-user%3ADavidGBrett+is%3Aopen&type=pullrequests";---

<section class="contributions" aria-labelledby="contributions-heading">
	<h2 id="contributions-heading">Open Source Contributions</h2>

	<ProjectCardsGrid projects={featuredContributions} />

	<div class="more-links">
		<a class="more-link" href={closedPRsLink} target="_blank" rel="noopener">
			Show all closed PRs…
		</a>

		<a class="more-link" href={openPRsLink} target="_blank" rel="noopener">
			Show all open PRs…
		</a>
	</div>

</section>

<style>
	h2 {
		margin: 0 0 1.25rem;
		font-size: clamp(1.4rem, 2vw, 1.9rem);
		color: var(--color-text);
	}

	.more-links {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
		flex-direction: row;
	}

    a.more-link {
        display: block;
		color: var(--color-text);
		transition: color 0.2s ease;
	}

	a.more-link:hover {
		color: var(--color-accent-primary);
	}
</style>
