---
import ProjectCardsGrid from './ProjectCardsGrid.astro';
import { featuredContributions } from '../data/featuredContributions';

let githubPullRequestsLink = "https://github.com/search?q=is%3Apr+author%3ADavidGBrett+-user%3ADavidGBrett++is%3Amerged&type=pullrequests&query=is%3Apr+is%3Aclosed+author%3ADavidGBrett+-user%3ADavidGBrett"
---

<section class="contributions" aria-labelledby="contributions-heading">
	<h2 id="contributions-heading">Open Source Contributions</h2>

	<ProjectCardsGrid projects={featuredContributions} />

    <a class="more-link" href={githubPullRequestsLink} target="_blank" rel="noopener">See more..</a>
</section>

<style>
	h2 {
		margin: 0 0 1.25rem;
		font-size: clamp(1.4rem, 2vw, 1.9rem);
		color: var(--color-text);
	}

    a.more-link {
        display: block;
        margin-top: 1rem;
		color: var(--color-text);
		transition: color 0.2s ease;
	}

	a.more-link:hover {
		color: var(--color-accent-primary);
	}
</style>
