---

const textLinks: { label: string; href: string }[] = [
	{ label: 'Projects', href: '/#projects-heading' },
	{ label: 'Open Source Contributions', href: '/#contributions-heading' },
];


---
<script>
    const nav = document.getElementById('nav');

    if (nav instanceof HTMLElement) {
        let isTicking = false;

        const syncNavScrollState = () => {
            const scrollY = Math.max(window.scrollY, 0);
            
            const wasScrolled = nav.classList.contains('scrolled');
            const isScrolled = scrollY > 0;
            if (wasScrolled !== isScrolled) {
                nav.classList.toggle('scrolled', isScrolled);
            }

            isTicking = false;
        };

        const onScroll = () => {
            if (isTicking) return;

            isTicking = true;
            window.requestAnimationFrame(syncNavScrollState);
        };

        syncNavScrollState();
        window.addEventListener('scroll', onScroll, { passive: true });
    }
</script>

<style>
    nav{
        width: 100vw;
        height: var(--nav-header-height);
        left: 0;
        top: 0;
        position: fixed;
        
        isolation: isolate;

        display: flex;
        flex-direction: row;
        align-items: center;

        background: transparent;
        border-bottom-color: transparent;
        border-bottom-style: solid;
        border-bottom-width: 0px;
        transition: background-color 0.25s ease, border-color 0.5s ease-out, border-bottom-width 0.1s ease-out;
    }
    nav.scrolled{
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(px);
        background: linear-gradient(
            to bottom,
            color-mix(in srgb, var(--color-bg-secondary) 100%, transparent),
            color-mix(in srgb, var(--color-bg-secondary) 80%, transparent)
        );
        border-bottom-color: var(--color-accent-primary);
        transition: background-color 0.25s ease, border-color 1s ease-in, border-bottom-width 0.2s ease-in;
        border-bottom-width: 4px;
    }
    .nav-items {
		margin: 0;
		display: flex;
		flex-direction: row;
		gap: 1rem;
		font-size: 1rem;
		line-height: 1.2;
		list-style: none;
	}
    .link {
        position: relative;
        display: inline-block;
        padding: 0.35rem 0.15rem;
        color: var(--color-text);
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -0.15rem;
        width: 100%;
        height: 2px;
        background: var(--color-accent-primary);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.2s ease;
    }
    .link:hover,
    .link:focus-visible {
        color: var(--color-accent-primary);
    }
    .link:hover::after,
    .link:focus-visible::after {
        transform: scaleX(1);
    }
</style>

<nav id="nav">
    <ul class="nav-items">
        {
				textLinks.map(({ label, href }) => (
					<li>
						<a class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
    </ul>
</nav>