---

const textLinks: { label: string; href: string }[] = [
    { label: 'About', href: '/#' },
	{ label: 'Projects', href: '/#projects-heading' },
	{ label: 'Open Source Contributions', href: '/#contributions-heading' },
];


---
<script>
    const nav = document.getElementById('nav');

    if (nav instanceof HTMLElement) {
        // --- Config ---

        // How far ahead of the nav bottom a heading can be and still count as scrolled passed
        const scrolledPastOffsetPx = 50;

        // --- Get linksByHeadingId ---

        const isCurrentPageUrl = (url: URL) => url.pathname === window.location.pathname;

        const isTopAnchorHref = (href: string | null): boolean => {
            if (!href) return false;
            const url = new URL(href, window.location.href);
            return isCurrentPageUrl(url) && (url.hash === '' || url.hash === '#' || url.hash === '#top');
        };

        const getHeadingIdFromHref = (href: string | null): string | null => {
            if (!href) return null;
            const url = new URL(href, window.location.href);
            const isCurrentPage = isCurrentPageUrl(url);
            const hash = url.hash.startsWith('#') ? url.hash.slice(1) : '';
            return isCurrentPage && hash ? hash : null;
        };

        const navLinks = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a.link'));
        const topAnchorLinks = navLinks.filter(link => isTopAnchorHref(link.getAttribute('href')));

        const linksByHeadingId = new Map<string, HTMLAnchorElement>(
            navLinks.flatMap(link => {
                const headingId = getHeadingIdFromHref(link.getAttribute('href'));
                return headingId ? ([[headingId, link]] as const) : [];
            })
        );

        // --- State update functions ---

        const updateScrolledState = (scrollY: number) => {
            nav.classList.toggle('scrolled', scrollY > 0);
        };

        const updateActiveLinkState = (scrollY: number) => {
            const threshold = scrollY + nav.getBoundingClientRect().height + scrolledPastOffsetPx;

            // Collect headings that have been scrolled past the threshold
            const scrolledPastHeadings = Array.from(linksByHeadingId.keys())
                .map(headingId => {
                    const heading = document.getElementById(headingId);
                    if (!heading) return null;
                    const headingY = heading.getBoundingClientRect().top + scrollY;
                    return headingY <= threshold ? { headingId, headingY } : null;
                })
                .filter((entry): entry is NonNullable<typeof entry> => entry !== null);

            // The active heading is the farthest one already scrolled past
            const activeHeading = scrolledPastHeadings
                .sort((a, b) => b.headingY - a.headingY)[0];

            navLinks.forEach(link => link.removeAttribute('aria-current'));

            if (activeHeading) {
                const activeHeadingLink = linksByHeadingId.get(activeHeading.headingId);
                activeHeadingLink?.setAttribute('aria-current', 'page');
                return;
            }

            // Fallback to top links (/# or #) while no heading has been scrolled past.
            topAnchorLinks.forEach(link => link.setAttribute('aria-current', 'page'));
        };

        // --- Scroll handler ---

        let isTicking = false;

        const onScrollFrame = () => {
            const scrollY = Math.max(window.scrollY, 0);
            updateScrolledState(scrollY);
            updateActiveLinkState(scrollY);
            isTicking = false;
        };

        const onScroll = () => {
            if (isTicking) return;
            isTicking = true;
            window.requestAnimationFrame(onScrollFrame);
        };

        onScrollFrame();
        window.addEventListener('scroll', onScroll, { passive: true });
    }
</script>

<style>
    nav{
        width: 100vw;
        height: var(--nav-header-height);
        left: 0;
        top: 0;
        position: fixed;
        
        isolation: isolate;

        display: flex;
        flex-direction: row;
        align-items: center;

        background: transparent;
        border-bottom-color: transparent;
        border-bottom-style: solid;
        border-bottom-width: 0px;
        transition: background-color 0.25s ease, border-color 0.5s ease-out, border-bottom-width 0.1s ease-out;
    }
    nav.scrolled{
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        background: linear-gradient(
            to bottom,
            color-mix(in srgb, var(--color-bg-secondary) 100%, transparent),
            color-mix(in srgb, var(--color-bg-secondary) 80%, transparent)
        );
        border-bottom-color: var(--color-accent-primary);
        transition: background-color 0.25s ease, border-color 1s ease-in, border-bottom-width 0.2s ease-in;
        border-bottom-width: 4px;
    }
    .nav-items {
		margin: 0;
		display: flex;
		flex-direction: row;
		gap: 1rem;
		font-size: 1rem;
		line-height: 1.2;
		list-style: none;
	}
    .link {
        position: relative;
        display: inline-block;
        padding: 0.35rem 0.15rem;
        color: var(--color-text);
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -0.15rem;
        width: 100%;
        height: 2px;
        background: var(--color-accent-primary);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.2s ease;
    }
    .link:hover,
    .link:focus-visible,
    .link[aria-current='page'] {
        color: var(--color-accent-primary);
    }
    .link:hover::after,
    .link:focus-visible::after,
    .link[aria-current='page']::after {
        transform: scaleX(1);
    }
</style>

<nav id="nav">
    <ul class="nav-items">
        {
				textLinks.map(({ label, href }) => (
					<li>
						<a class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
    </ul>
</nav>