---

const textLinks: { label: string; href: string }[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Projects', href: '/projects/' },
	{ label: 'About', href: '/about/' },
];

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---
<script>
    console.log("Script")
    window.addEventListener('scroll', function() {
        const nav = document.querySelector('nav');
        if (nav === null){return}
        if (window.scrollY > 0) {
            nav.classList.add('scrolled');
        } else {
            nav.classList.remove('scrolled');
        }
    });
</script>

<style>
    nav{
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        width: 100vw;
        height: var(--nav-header-height);
        left: 0;
        top: 0;
        position: fixed;

        display: flex;
        flex-direction: row;
        align-items: center;

        border-bottom-color: transparent;
        border-bottom-style: solid;
        border-bottom-width: 0px;
        transition: border-color 0.5s ease-out, border-bottom-width 0.1s ease-out;
    }
    nav.scrolled{
        border-bottom-color: var(--color-accent-primary);
        transition: border-color 1s ease-in, border-bottom-width 0.2s ease-in;
        border-bottom-width: 4px;
    }
    .nav-items {
		margin: 0;
		display: flex;
		flex-direction: row;
		gap: 1rem;
		font-size: 1rem;
		line-height: 1.2;
		list-style: none;
	}
    .link {
        color: var(--color-text);
    }
    .link:hover,
    .link:focus-visible,
    .link[aria-current='page'] {
        color: var(--color-accent-primary);
    }
</style>

<nav id="nav">
    <ul class="nav-items">
        {
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
    </ul>
</nav>